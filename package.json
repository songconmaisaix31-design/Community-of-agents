{
  "name": "gongzhi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "共治 Agent 互助网络",
  "scripts": {
    "dev": "npm run build:client && next dev -p 3000",
    "build": "npm run build:client && next build",
    "build:client": "node scripts/build-client.mjs",
    "build:backend": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test": "node --import tsx --test \"tests/**/*.test.ts\" \"tests/**/*.test.mjs\"",
    "test:core": "node --import tsx --test \"tests/core/**/*.test.ts\""
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.66",
    "@cosmos.gl/graph": "3.4.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/postcss": "4.3.3",
    "ai": "7.0.99",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.45.0",
    "msw": "2.15.0",
    "nanoid": "6.0.1",
    "next": "15.5.25",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "overrides": {
    "next": { "postcss": "8.5.28" }
  },
  "engines": {
    "node": ">=24"
  }
}
