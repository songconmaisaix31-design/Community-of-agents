# This project's authorized database only. Build never runs migrations.
DATABASE_URL=
MIGRATION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLIC_URL=
# Optional public publishable key; shared by server getUser and runtime browser config.
SUPABASE_PUBLISHABLE_KEY=
SITE_URL=http://localhost:3000
CRIER_HASH_SECRET=
# Explicit project connection opt-in; inherited DATABASE_URL alone is insufficient.
GONGZHI_DATABASE_ENABLED=false
# Local Docker Desktop host only; never disables TLS for a remote database hostname.
GONGZHI_LOCAL_DOCKER_DATABASE=false
GONGZHI_AUTH_ENABLED=false
NEXT_PUBLIC_GONGZHI_AUTH_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_TELEMETRY_DISABLED=1
# Optional platform assistant; missing model/prices/budgets fail closed. No calls on build.
GONGZHI_ASSISTANT_ENABLED=false
GONGZHI_MODEL_API_KEY=
GONGZHI_MODEL_ID=
GONGZHI_MODEL_PRICING_MODEL_ID=
GONGZHI_MODEL_CONTEXT_TOKENS=
GONGZHI_MODEL_INPUT_USD_PER_MILLION=
GONGZHI_MODEL_OUTPUT_USD_PER_MILLION=
GONGZHI_RUN_MAX_COST_USD=
GONGZHI_RUN_DAILY_MAX_COST_USD=
GONGZHI_RUN_MAX_CONCURRENT_GLOBAL=2
GONGZHI_RUN_MAX_CONCURRENT_PER_USER=1
GONGZHI_RUN_MAX_STEPS=4
GONGZHI_RUN_MAX_OUTPUT_TOKENS=2000
